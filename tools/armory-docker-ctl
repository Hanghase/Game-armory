#!/bin/bash
# Game-Armory - Docker-Steuerung (privilegierter Helfer)
# Wird per sudo vom armory-User aufgerufen. Erlaubt NUR:
#   - Aktionen: status | ps | logs | start | stop | restart
#   - Stacks aus einer festen Tabelle (NAME, nie ein Pfad)
#   - Dienste aus der Dienstliste des jeweiligen Stacks
#
# Kein Shell-Durchreichen, keine freien Argumente, kein `docker run`,
# kein `docker exec`, kein freies `-f`.
#
# Warum das noetig ist (2026-11-07): Der armory-User ist NICHT in der
# docker-Gruppe - mit Absicht. Wer den Docker-Socket schreiben darf, ist
# de facto root (docker run -v /:/host). Deshalb liest dieser Helfer als
# root und gibt nur die Auswertung zurueck. Die compose-.env (root:root 600)
# wird dabei gelesen, ihr Inhalt verlaesst das Skript aber nie.
#
# --- Erweitert 2026-11-10 (Karte 28: bestehende Dienste uebernehmen) --------
#
# Vorher war der Helfer an GENAU EINE Compose-Datei gebunden. Fuer das
# Uebernehmen fremder Stacks muss er mehrere kennen - aber weiterhin nicht
# beliebige.
#
# Deshalb: der Aufrufer waehlt einen NAMEN, niemals einen Pfad.
#   alt:  armory-docker-ctl <aktion> <dienst> [zeilen]
#   neu:  armory-docker-ctl <stack> <aktion> [dienst] [zeilen]
#
# Der Pfad entsteht ERST hier, aus der Tabelle unten. Ein Pfad aus der
# Kommandozeile wird nicht angenommen - das ist die Grenze, an der die
# Sicherheit haengt: wer den Pfad waehlen darf, waehlt, welcher Stack
# gesteuert wird.
#
# Die Tabelle ist bewusst eine feste Liste und kein Verzeichnis-Scan. Ein
# Scan wuerde jeden Ordner mit einer docker-compose.yml zu einem steuerbaren
# Ziel machen - auf diesem Host liegt z.B. /root/openclaw/docker-compose.yml,
# aus dem KEIN Container laeuft (live nachgemessen 2026-11-10). Ein neuer
# Stack kommt durch einen Eintrag hier hinein, nicht durch bloßes Existieren.
#
# Bewusst NICHT enthalten: down, rm, exec, build, run. `down` entfernt den
# Stack samt Netzwerk, `exec` waere root im Container - beides ist keine
# Serversteuerung mehr, sondern Umbau.

set -euo pipefail

ALLOWED_ACTIONS="status ps logs start stop restart"

# Obergrenze fuer Log-Zeilen - verhindert, dass das Panel den Speicher flutet.
MAX_LINES=2000

# --- Stack-Tabelle ----------------------------------------------------------
# Format: <name>|<compose-datei>|<dienste, leerzeichengetrennt>
#
# Ein Eintrag mit leeren Diensten bedeutet: die Dienstliste wird aus der
# Compose-Datei gelesen (docker compose config --services). Das ist der
# Normalfall fuer einen uebernommenen Stack, dessen Dienste der Betreiber
# nicht einzeln eintragen will.
#
# Die Dienste-Freigabe bleibt trotzdem noetig: was nicht in der Datei steht,
# kommt nicht durch.
STACKS="
nextcloud|/opt/nextcloud/docker-compose.yml|nc-app nc-db nc-redis
"

# --- Erlaubte Pfad-Wurzel ---------------------------------------------------
# Auch wenn der Pfad aus der Tabelle kommt: er wird gegen diese Wurzel
# aufgeloest. Damit faellt ein Symlink auf, der aus /opt herauszeigt.
ALLOWED_ROOT="/opt"

# --- Argumente --------------------------------------------------------------
stack="${1:-}"
action="${2:-}"

# 1) Aktion whitelisten
case " $ALLOWED_ACTIONS " in
  *" $action "*) ;;
  *) echo "Unerlaubte Aktion: ${action}" >&2; exit 2 ;;
esac

# --- Stackpruefung, an EINER Stelle -----------------------------------------
# Dieselbe Zweistufigkeit wie bei pruefe_dienst: erst die Form, dann der
# exakte Wortvergleich gegen die Tabelle.
# Ohne die Formpruefung kaeme "nextcloud; rm -rf /" bis zum Wortvergleich -
# der wuerde zwar ablehnen, aber verlassen wollen wir uns nicht darauf.
pruefe_stack() {
  local name="${1:-}"
  if [[ -z "$name" ]]; then
    echo "Stack nicht erlaubt: (fehlt)" >&2
    exit 9
  fi
  if [[ ! "$name" =~ ^[a-z0-9][a-z0-9_-]*$ ]]; then
    echo "Stack nicht erlaubt: $name" >&2
    exit 9
  fi
  local zeile
  while IFS= read -r zeile; do
    [[ -z "$zeile" ]] && continue
    if [[ "${zeile%%|*}" == "$name" ]]; then
      return 0
    fi
  done <<< "$STACKS"
  echo "Stack nicht erlaubt: $name" >&2
  exit 9
}

# Gibt die Compose-Datei eines Stacks aus der Tabelle zurueck.
stack_datei() {
  local name="$1" zeile
  while IFS= read -r zeile; do
    [[ -z "$zeile" ]] && continue
    if [[ "${zeile%%|*}" == "$name" ]]; then
      # Feld 2 ist der Pfad. Mit cut, weil der Pfad kein '|' enthaelt.
      printf '%s\n' "$zeile" | cut -d'|' -f2
      return 0
    fi
  done <<< "$STACKS"
  return 1
}

# Gibt die eingetragene Dienstliste zurueck (Feld 3), kann leer sein.
stack_dienste() {
  local name="$1" zeile
  while IFS= read -r zeile; do
    [[ -z "$zeile" ]] && continue
    if [[ "${zeile%%|*}" == "$name" ]]; then
      printf '%s\n' "$zeile" | cut -d'|' -f3
      return 0
    fi
  done <<< "$STACKS"
  return 1
}

pruefe_stack "$stack"

COMPOSE_FILE="$(stack_datei "$stack")"

# --- Pfad aufloesen und gegen die Wurzel pruefen ----------------------------
# Heute kommt der Pfad aus der Tabelle, also aus dem Skript selbst. Die
# Aufloesung ist trotzdem noetig: ein Symlink koennte aus /opt herauszeigen,
# und dann wuerde ein Eintrag "harmlos aussehen", aber woandershin steuern.
if [[ ! -e "$COMPOSE_FILE" ]]; then
  echo "Compose-Datei nicht lesbar: $COMPOSE_FILE" >&2
  exit 3
fi
AUFGELOEST="$(realpath -e "$COMPOSE_FILE" 2>/dev/null || true)"
if [[ -z "$AUFGELOEST" ]]; then
  echo "Compose-Datei nicht aufloesbar: $COMPOSE_FILE" >&2
  exit 3
fi
case "$AUFGELOEST" in
  "$ALLOWED_ROOT"/*) ;;
  *) echo "Compose-Datei ausserhalb von $ALLOWED_ROOT: $AUFGELOEST" >&2; exit 3 ;;
esac
if [[ ! -r "$AUFGELOEST" ]]; then
  echo "Compose-Datei nicht lesbar: $AUFGELOEST" >&2
  exit 3
fi
COMPOSE_FILE="$AUFGELOEST"

# --- Dienstpruefung, an EINER Stelle -------------------------------------
# Der alte Weg war ein case-Vergleich gegen " nc-app nc-db nc-redis ".
# Der prueft den GANZEN String als Teilstring - also kam
#   "nc-app nc-db"
# durch die Whitelist, und docker compose bekam daraus ZWEI Dienste
# (live nachgemessen 2026-11-07: rc=8, "no such service").
# Mit einem anderen Paar waere das ein freies zweites Ziel gewesen.
# Deshalb jetzt: erst Form pruefen (keine Leerzeichen, keine Optionen),
# dann exakter Wortvergleich.
pruefe_dienst() {
  local name="${1:-}"
  if [[ -z "$name" ]]; then
    echo "Dienst nicht erlaubt: (fehlt)" >&2
    exit 4
  fi
  if [[ ! "$name" =~ ^[a-z0-9][a-z0-9_-]*$ ]]; then
    echo "Dienst nicht erlaubt: $name" >&2
    exit 4
  fi

  # Die erlaubte Liste kommt aus der Tabelle. Ist sie leer, wird sie aus der
  # Compose-Datei gelesen - das ist der Fall fuer einen uebernommenen Stack.
  local liste dienste
  liste="$(stack_dienste "$stack")"
  if [[ -z "$liste" ]]; then
    if ! dienste="$(docker compose -f "$COMPOSE_FILE" config --services 2>&1)"; then
      echo "Dienstliste nicht lesbar: $dienste" >&2
      exit 4
    fi
    liste="$dienste"
  fi

  local erlaubt
  for erlaubt in $liste; do
    if [[ "$name" == "$erlaubt" ]]; then
      return 0
    fi
  done
  echo "Dienst nicht erlaubt: $name" >&2
  exit 4
}

compose() {
  docker compose -f "$COMPOSE_FILE" "$@"
}

# --- Argumentzahl -----------------------------------------------------------
# Die Zaehlung haengt an der Aktion, weil `status`/`ps` keinen Dienst nehmen
# und `logs` zusaetzlich die Zeilenzahl.
case "$action" in
  status|ps)
    if [[ $# -gt 2 ]]; then
      echo "Zu viele Argumente: $action nimmt keinen Dienst" >&2
      exit 7
    fi
    ;;
  start|stop|restart)
    if [[ $# -ne 3 ]]; then
      echo "Falsche Argumentzahl: $stack $action <dienst>" >&2
      exit 7
    fi
    ;;
  logs)
    if [[ $# -lt 3 ]] || [[ $# -gt 4 ]]; then
      echo "Falsche Argumentzahl: $stack logs <dienst> [zeilen]" >&2
      exit 7
    fi
    ;;
esac

case "$action" in
  status)
    # Ein Aufruf, JSON pro Dienst. --format json gibt es seit Compose v2.
    # ACHTUNG: `set -e` bricht bei einem Fehler sofort ab, BEVOR `||` greift.
    # Deshalb hier explizit if/else statt `||` - sonst ist die Meldung weg
    # und der Exit-Code immer 0 (eigener Fehler, am 2026-11-07 bemerkt).
    if ! out=$(compose ps --format json 2>&1); then
      rc=$?
      echo "docker compose ps fehlgeschlagen (rc=$rc): $out" >&2
      exit 6
    fi
    printf '%s\n' "$out"
    ;;

  ps)
    # Kurzform fuer Menschen: NAME ZUSTAND STATUS
    compose ps 2>&1
    ;;

  logs)
    service="${3:-}"
    lines="${4:-200}"

    # Dienst MUSS aus der Dienstliste kommen (kein freier Container-Name)
    pruefe_dienst "$service"

    # Zeilenzahl streng numerisch und begrenzt
    if [[ ! "$lines" =~ ^[0-9]+$ ]]; then
      echo "Ungueltige Zeilenzahl: $lines" >&2
      exit 5
    fi
    if (( lines < 1 )); then lines=1; fi
    if (( lines > MAX_LINES )); then lines=$MAX_LINES; fi

    # --no-color, damit im Panel keine ANSI-Escapes stehen
    compose logs --tail "$lines" --no-color "$service" 2>&1
    ;;
  start|stop|restart)
    service="${3:-}"

    # Dienst MUSS aus der Dienstliste kommen - kein freier Container-Name.
    pruefe_dienst "$service"

    # --timeout nur bei stop/restart: `docker compose start` kennt das Flag
    # NICHT und bricht mit "unknown flag: --timeout" ab (live erwischt
    # 2026-11-07 - der start schlug fehl, obwohl die Aktion richtig war).
    if [[ "$action" == "start" ]]; then
      if ! out=$(compose start "$service" 2>&1); then
        rc=$?
        echo "docker compose start $service fehlgeschlagen (rc=$rc): $out" >&2
        exit 8
      fi
      printf '%s\n' "$out"
      exit 0
    fi

    # --timeout begrenzt das Warten: sonst wartet stop bis zu 10s pro Dienst
    # und das Panel laeuft in einen Timeout.
    if ! out=$(compose "$action" --timeout 20 "$service" 2>&1); then
      rc=$?
      echo "docker compose $action $service fehlgeschlagen (rc=$rc): $out" >&2
      exit 8
    fi
    printf '%s\n' "$out"
    ;;
esac

exit 0
